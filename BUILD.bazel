load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

CXX17_COPTS = select({
    "@platforms//os:windows": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

cc_library(
    name = "fast-bleu-cpp",
    hdrs = ["include/fast_bleu/bleu.hpp"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "bleu_test",
    srcs = ["tests/bleu_test.cc"],
    copts = CXX17_COPTS,
    deps = [":fast-bleu-cpp"],
)

cc_binary(
    name = "example",
    srcs = ["examples/basic.cc"],
    copts = CXX17_COPTS,
    deps = [":fast-bleu-cpp"],
)
